<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Cambiar Contraseña</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-900 text-center p-10">
<section class="max-w-md mx-auto">

    <h1 class="text-3xl font-bold text-indigo-500 mb-6">Cambiar Contraseña</h1>

    <% if (error) { %>
    <div class="bg-red-500 text-white p-3 rounded mb-4"><%= error %></div>
    <% } %>

    <% if (success) { %>
    <div class="bg-green-500 text-white p-3 rounded mb-4"><%= success %></div>
    <% } %>

    <form action="/cambiar-password" method="POST" class="bg-gray-100 p-6 rounded-xl shadow space-y-4">

        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div>
            <label class="block font-semibold mb-1">Contraseña actual</label>
            <input type="password" name="passwordActual" required class="w-full p-2 rounded border">
        </div>

        <div>
            <label class="block font-semibold mb-1">Nueva contraseña</label>
            <input type="password" name="passwordNueva" required class="w-full p-2 rounded border">
        </div>

        <div>
            <label class="block font-semibold mb-1">Confirmar nueva contraseña</label>
            <input type="password" name="passwordConfirm" required class="w-full p-2 rounded border">
        </div>

        <input
            type="submit"
            value="Actualizar"
            class="bg-indigo-600 text-white px-4 py-2 rounded cursor-pointer hover:bg-indigo-700 transition"
        >
    </form>

    <a href="/menu" class="block mt-6 text-indigo-400 underline">Volver al menú</a>

</section>
</body>
</html>
