<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Detalle del Equipo</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/pokedex.css">
    <style>
        @media print { #btn-pdf, .no-print { display: none !important; } }
        @media print {
            #btn-pdf, .no-print { display: none !important; }

            body { background: white !important; padding: 16px; }

            section { max-width: 100% !important; }

            h1 { color: #6d28d9 !important; }

            .bg-gray-800 {
                background: #f3f4f6 !important;
                border: 1px solid #d1d5db;
                box-shadow: none !important;
                page-break-inside: avoid;
            }

            .bg-gray-700 {
                background: #e5e7eb !important;
                border: 1px solid #d1d5db;
            }

            .text-white, .text-gray-200 { color: #111827 !important; }
            .text-gray-400               { color: #6b7280 !important; }
            .text-purple-300             { color: #7c3aed !important; }
            .text-red-300                { color: #dc2626 !important; }
            .text-green-300              { color: #16a34a !important; }
            .text-yellow-300             { color: #d97706 !important; }

            /* Mantener colores de badges de tipo */
            .type-badge { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        }
    </style>
</head>

<body class="bg-gray-900 p-6">
<section class="max-w-5xl mx-auto">

    <div class="flex items-center justify-between mb-8">
        <h1 class="text-4xl text-purple-400">Detalle del Equipo</h1>
        <a href="/equipo/pdf"
            class="bg-purple-600 hover:bg-purple-700 text-white text-sm font-semibold px-5 py-2 rounded-lg transition">
            Descargar PDF
        </a>
    </div>

    <div class="flex flex-col gap-6">
    <% equipo.forEach(p => { %>

        <div class="bg-gray-800 rounded-2xl shadow-lg p-6 flex flex-col md:flex-row gap-6">

            <%/* Imagen + nombre */%>
            <div class="flex flex-col items-center justify-center min-w-[140px]">
                <img src="<%= p.imagen %>" class="w-32 h-32 object-contain" alt="<%= p.nombre %>">
                <h2 class="text-white font-bold text-xl capitalize mt-2"><%= p.nombre %></h2>
                <div class="flex gap-1 mt-1 flex-wrap justify-center">
                    <% p.types.forEach(t => { %>
                        <span class="type-badge type-<%= t %>"><%= t %></span>
                    <% }) %>
                </div>
            </div>

            <%/* Info VGC */%>
            <div class="flex-1 grid grid-cols-2 lg:grid-cols-4 gap-4 text-sm">

                <%/* Habilidades */%>
                <div class="bg-gray-700 rounded-xl p-4">
                    <h3 class="text-purple-300 font-semibold mb-2 uppercase tracking-wide text-xs">Habilidades</h3>
                    <ul class="text-gray-200 space-y-1">
                        <% p.abilities.forEach(a => { %>
                            <li class="capitalize">
                                <%= a.name %>
                                <% if (a.hidden) { %>
                                    <span class="text-gray-400 text-xs">(oculta)</span>
                                <% } %>
                            </li>
                        <% }) %>
                    </ul>
                </div>

                <%/* Debilidades */%>
                <div class="bg-gray-700 rounded-xl p-4">
                    <h3 class="text-red-300 font-semibold mb-2 uppercase tracking-wide text-xs">Debilidades</h3>
                    <div class="flex flex-wrap gap-1">
                        <% if (p.weaknesses.length === 0) { %>
                            <span class="text-gray-400 text-xs">Ninguna</span>
                        <% } %>
                        <% p.weaknesses.forEach(w => { %>
                            <span class="type-badge type-<%= w.type %>"><%= w.type %> x<%= w.mult %></span>
                        <% }) %>
                    </div>
                </div>

                <%/* Resistencias */%>
                <div class="bg-gray-700 rounded-xl p-4">
                    <h3 class="text-green-300 font-semibold mb-2 uppercase tracking-wide text-xs">Resistencias</h3>
                    <div class="flex flex-wrap gap-1">
                        <% if (p.resistances.length === 0) { %>
                            <span class="text-gray-400 text-xs">Ninguna</span>
                        <% } %>
                        <% p.resistances.forEach(r => { %>
                            <span class="type-badge type-<%= r.type %>">
                                <%= r.type %><%= r.mult === 0 ? ' ✕' : ' ½' %>
                            </span>
                        <% }) %>
                    </div>
                </div>

                <%/* Moveset */%>
                <div class="bg-gray-700 rounded-xl p-4">
                    <h3 class="text-yellow-300 font-semibold mb-2 uppercase tracking-wide text-xs">Moveset</h3>
                    <ul class="text-gray-200 space-y-1">
                        <% p.moves.forEach(m => { %>
                            <li class="capitalize"><%= m %></li>
                        <% }) %>
                    </ul>
                </div>

            </div>

        </div>

    <% }) %>
    </div>

    <div class="text-center mt-10 no-print">
        <form action="/equipo/limpiar" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit"
                    class="bg-gray-600 hover:bg-gray-500 text-white text-sm font-semibold px-5 py-2 rounded-lg transition">
                Volver al menú
            </button>
        </form>
    </div>

</section>
</body>
</html>
