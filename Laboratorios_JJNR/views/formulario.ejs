<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Agregar Pokémon</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-900 text-center p-6">
<section class="max-w-xl mx-auto">

    <h1 class="text-3xl font-bold text-indigo-600 mb-6">Agregar Pokémon</h1>

    <form action="/pokedex/new?_csrf=<%= csrfToken %>" method="POST" enctype="multipart/form-data"
            class="bg-gray-100 p-6 rounded-xl shadow-md space-y-4">

        <div class="bg-gray-300 border border-gray-500 p-4 rounded-lg shadow-sm">
            <label class="block font-semibold mb-1">Nombre</label>
            <input name="nombre" class="w-full border p-2 rounded" type="text" required minlength="2">
        </div>

        <div class="bg-gray-300 border border-gray-500 p-4 rounded-lg shadow-sm">
            <label class="block font-semibold mb-1">Imagen</label>
            <input name="imagen" class="w-full border p-2 rounded bg-white" type="file"
                    accept="image/jpeg,image/png,image/gif,image/webp" required>
        </div>

        <input class="bg-indigo-600 text-white border px-4 py-2 rounded cursor-pointer hover:bg-indigo-700 transition"
                type="submit" value="Guardar Pokémon">

    </form>

    <a href="/menu" class="block mt-10 text-indigo-600 underline text-lg">Volver al menú</a>

</section>
</body>
</html>
