<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Pokédex</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/pokedex.css">
</head>

<%
function getGen(id) {
    if (id <= 151) return 1;
    if (id <= 251) return 2;
    if (id <= 386) return 3;
    if (id <= 493) return 4;
    if (id <= 649) return 5;
    if (id <= 721) return 6;
    if (id <= 809) return 7;
    if (id <= 905) return 8;
    return 9;
}
const genLabels = ['Gen I','Gen II','Gen III','Gen IV','Gen V','Gen VI','Gen VII','Gen VIII','Gen IX'];
%>

<body class="bg-gray-900 text-center p-6">
<section class="max-w-6xl mx-auto">

    <input type="hidden" id="csrfToken" value="<%= csrfToken %>">

    <h1 class="text-4xl font-bold text-indigo-500 mb-1">Pokédex</h1>
    <p class="text-gray-400 mb-4 text-sm">
        <span id="contador-capturados"><%= Object.keys(capturedMap).length %></span>
        / <%= allPokemon.length %> capturados
    </p>

    <div class="flex justify-center mb-4">
        <button class="tab-btn bg-gray-700 text-gray-300 px-6 py-2 rounded-lg text-base font-semibold transition"
                data-gen="mis">
            Mis Pokémon
        </button>
    </div>

    <div class="mb-4 flex justify-end">
        <a href="/pokedex/new"
           class="bg-indigo-600 text-white px-4 py-2 rounded hover:bg-indigo-700 transition text-sm">
            + Agregar Pokémon
        </a>
    </div>

    <%/* Tabs de generación */%>
    <div class="flex flex-wrap gap-2 justify-center mb-6">
        <% for (let i = 1; i <= 9; i++) { %>
            <button class="tab-btn bg-gray-700 text-gray-300 px-3 py-1 rounded text-sm font-medium transition"
                    data-gen="<%= i %>">
                <%= genLabels[i-1] %>
            </button>
        <% } %>
    </div>

    <%/* Grid */%>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">

        <% allPokemon.forEach(p => { %>
            <% const captured = capturedMap[p.name]; %>
            <% const gen = getGen(p.id); %>

            <div class="poke-card-wrapper"
                 data-gen="<%= gen %>"
                 data-captured="<%= captured ? 'true' : 'false' %>">

                <% if (captured) { %>
                    <div class="card" data-name="<%= p.name %>">
                        <div class="card-inner">

                            <div class="card-front bg-white p-3 rounded-xl shadow flex flex-col items-center">
                                <span class="text-gray-400 text-xs self-start">#<%= String(p.id).padStart(3, '0') %></span>
                                <img src="<%= captured.imagen %>"
                                     class="w-full h-32 object-contain my-1"
                                     alt="<%= p.name %>">
                                <h3 class="text-sm font-bold capitalize mt-1"><%= p.name %></h3>
                                <button class="btn-eliminar absolute bottom-2 right-2 bg-red-500 hover:bg-red-600 text-white text-xs px-2 py-1 rounded transition hidden"
                                        data-id="<%= captured.id_pokemon %>">
                                    Eliminar
                                </button>
                            </div>

                            <div class="card-back bg-indigo-800 rounded-xl shadow"></div>

                        </div>
                    </div>

                <% } else { %>
                    <div class="card-locked">
                        <p class="text-white font-bold text-lg">#<%= String(p.id).padStart(3, '0') %></p>
                    </div>
                <% } %>

            </div>

        <% }) %>

    </div>

    <a href="/menu" class="block mt-10 text-indigo-400 underline text-sm">Volver al menú</a>

</section>

<script src="/js/pokedex.js"></script>
</body>
</html>
